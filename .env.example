ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
FINNHUB_API_KEY=
NEWSAPI_KEY=
DISCORD_WEBHOOK_URL=
# Optional: approve trades from Discord buttons (see docs/RUNBOOK.md "Approve from Discord")
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_APPROVER_IDS=

# --- trading mode (paper is the default; live needs BOTH lines) ---
TRADING_MODE=paper
# LIVE_TRADING_CONFIRMED=true

# --- optional overrides (defaults shown) ---
# TICKERS=SPY,QQQ,AAPL,NVDA,TSLA,ASTS
# TIMEFRAME=15Min
# ALPACA_DATA_FEED=sip           # sip = consolidated (matches TradingView); iex = one exchange, real-time
# SIP_DELAY_MINUTES=16           # free plan: SIP is >=15 min old; 0 with a real-time SIP subscription
# LIVE_HYBRID=true               # newest bars estimated from real-time IEX (no 16 min delay); false with a paid SIP plan
# EXIT_MODE=hybrid               # hybrid = stop + TARGET_RR take-profit + Pine exits (default); pine = stop + Pine exits; bracket = stop + structural target
# TARGET_RR=2.0                  # hybrid take-profit as a multiple of the stop distance (1:2)
# DEFAULT_TRADE_MODE=ask         # off | ask | auto for TICKERS (change per ticker on the dashboard)
# APPROVAL_TTL_MINUTES=10        # how long an Ask request waits for Approve / Reject
# INCLUDE_EXTENDED_HOURS=true   # false = regular session (09:30-16:00 ET) bars only at read time
# MAX_POSITION_PCT=0.05
# MAX_DAILY_LOSS_PCT=0.02
# MAX_OPEN_POSITIONS=3
# RISK_PER_TRADE_PCT=0.005
# MIN_MODEL_PROBABILITY=0.55
# REQUIRE_MODEL=false        # true = refuse to trade until a model is trained
# USE_UNVALIDATED_MODEL=false  # false = ignore a model that did not beat raw signals out of sample
# ALLOW_SHORTS=true
# FLATTEN_AT_CLOSE=true
# BROKER=alpaca              # "sim" = in-memory simulator, no orders sent anywhere

# Warn on entries this many minutes (or fewer) before the end-of-day flatten (115 = from 13:00 CT)
LATE_ENTRY_WARN_MINUTES=115
