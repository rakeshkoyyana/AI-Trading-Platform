ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
FINNHUB_API_KEY=
NEWSAPI_KEY=
DISCORD_WEBHOOK_URL=

# --- trading mode (paper is the default; live needs BOTH lines) ---
TRADING_MODE=paper
# LIVE_TRADING_CONFIRMED=true

# --- optional overrides (defaults shown) ---
# TICKERS=SPY,QQQ,AAPL,NVDA,TSLA,ASTS
# TIMEFRAME=15Min
# MAX_POSITION_PCT=0.05
# MAX_DAILY_LOSS_PCT=0.02
# MAX_OPEN_POSITIONS=3
# RISK_PER_TRADE_PCT=0.005
# MIN_MODEL_PROBABILITY=0.55
# REQUIRE_MODEL=false        # true = refuse to trade until a model is trained
# ALLOW_SHORTS=true
# FLATTEN_AT_CLOSE=true
# BROKER=alpaca              # "sim" = in-memory simulator, no orders sent anywhere
